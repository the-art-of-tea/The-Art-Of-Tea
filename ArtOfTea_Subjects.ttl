@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ArTea: <https://w3id.org/ArtOfTea/> .
@prefix loc: <http://id.loc.gov/authorities/subjects/> .
@prefix aspect: <https://w3id.org/ArtOfTea/aspects/> .
@prefix : <https://w3id.org/ArtOfTea/aspects#> .

:ResearchObject a owl:Class;
    rdfs:label "Research Object";
    rdfs:comment "The cultural object or area of focus which will form the heart of the library";
    owl:equivalentClass crm:E73_Information_Object .

:Aspect a owl:Class;
    rdfs:label "Aspect";
    rdfs:comment "The various aspects which form the understanding of the research object - derived from the Dewey Decimal Classification";
    owl:equivalentClass crm:E90_Symbolic_Object .

:BroadArea a owl:Class;
    rdfs:label "Broad Area";
    rdfs:comment "Subsection of the research aspects" ;
    owl:equivalentClass crm:E90_Symbolic_Object .

:NarrowSubject a owl:Class;
    rdfs:label "Narrow Subject";
    rdfs:comment "The specific topics that address the research object in question";
    owl:equivalentClass crm:E90_Symbolic_Object .


#Defining Tea as the cultural/research object 
aspect:Tea a :ResearchObject;
    rdfs:label "Tea" ;
    rdfs:seeAlso loc:sh85132924 .

#The cultural/research object is made up of several aspects - following the DDC 
aspect:Philosophy a :Aspect ;
    rdfs:label "Philosophy"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:Religion a :Aspect ;
    rdfs:label "Religion"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:History a :Aspect ;
    rdfs:label "History"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:Linguistics a :Aspect ;
    rdfs:label "Linguistics"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:ScienceAndTechnology a :Aspect ;
    rdfs:label "Science and Technology"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:Art a :Aspect ;
    rdfs:label "Art"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:Literature a :Aspect ;
    rdfs:label "Literature"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:Culture a :Aspect ;
    rdfs:label "Culture"@en ;
    crm:P106i_forms_part_of ArTea:Tea .
aspect:PoliticsAndEconomics a :Aspect ;
    rdfs:label "Politics and Economics"@en ;
    crm:P106i_forms_part_of ArTea:Tea .

#Within each aspect are broad areas
aspect:Botany a :BroadArea ;
    rdfs:label "Botany"@en ;
    crm:P106i_forms_part_of aspect:ScienceAndTechnology .
aspect:Narcotics a :BroadArea ;
    rdfs:label "Narcotics"@en ;
    crm:P106i_forms_part_of aspect:ScienceAndTechnology .
aspect:Oxidation a :BroadArea ;
    rdfs:label "Oxidation"@en ;
    crm:P106i_forms_part_of aspect:ScienceAndTechnology .
aspect:Manufacturing a :BroadArea ;
    rdfs:label "Manufacturing"@en ;
    crm:P106i_forms_part_of aspect:ScienceAndTechnology ;
    crm:P106i_forms_part_of aspect:PoliticsAndEconomics ;
    crm:P106i_forms_part_of aspect:History .
aspect:Commerce a :BroadArea ;
    rdfs:label "Commerce"@en ;
    crm:P106i_forms_part_of aspect:PoliticsAndEconomics .
aspect:WarConflict a :BroadArea ;
    rdfs:label "War and Conflict"@en ;
    crm:P106i_forms_part_of aspect:PoliticsAndEconomics ;
    crm:P106i_forms_part_of aspect:History .
aspect:Trade a :BroadArea ;
    rdfs:label "Trade"@en ;
    crm:P106i_forms_part_of aspect:PoliticsAndEconomics ;
    crm:P106i_forms_part_of aspect:History .
aspect:ReligiousPractice a :BroadArea ;
    rdfs:label "Religious Practice"@en ;
    crm:P106i_forms_part_of aspect:Religion .
aspect:CulturalPractice a :BroadArea ;
    rdfs:label "Cultural Practice"@en ;
    crm:P106i_forms_part_of aspect:Culture .
aspect:CulturalSpace a :BroadArea ;
    rdfs:label "Cultural Space"@en ;
    crm:P106i_forms_part_of aspect:Culture .

