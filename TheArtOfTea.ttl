ArTea:arTea15 a schema:WebPage ;
    bf:mainTitle "The Classic of Tea" ;
    dcterms:contributor <http://viaf.org/viaf/98018752> ;
    bf:responsibilityStatement "Studentoftea.com" ;
    bf:date "2025-10-14"^^xsd:date ;
    bf:place <https://archive.org/details/bookoftea00okakrich/mode/2up> ;
    bf:originPlace "-" ;
    bf:originDate "-" ;
    dcterms:source <https://www.studentoftea.com/p/the-classic-of-tea-and-its-english-translation> ;
    dcterms:rights "-" ;
    dcterms:abstract "Before moving further into the art of tea, it is worth returning to where written tea culture began. The Classic of Tea (茶经) was written by Lu Yu (陆羽) during the Tang dynasty (618 to 907 AD). It is the first known monograph on tea and tea culture in the world." ;
    dcterms:subject 
        <http://id.loc.gov/authorities/subjects/sh85019114>,
        <http://id.loc.gov/authorities/subjects/sh98001340>,
        <http://id.loc.gov/authorities/subjects/sh97008800>,
        <http://id.loc.gov/authorities/subjects/sh85069734>,
        <http://id.loc.gov/authorities/subjects/sh2009000722>,
        <http://id.loc.gov/authorities/subjects/sh2008112604>,
        <http://id.loc.gov/authorities/subjects/sh2020004829>,
        <http://id.loc.gov/authorities/subjects/sh85132940>,
        <http://id.loc.gov/authorities/subjects/sh85132942>,
        <http://id.loc.gov/authorities/subjects/sh85132392>,
        <http://id.loc.gov/authorities/subjects/sh85149720> ;
    crm:P129_is_about ArTea:Tea .

