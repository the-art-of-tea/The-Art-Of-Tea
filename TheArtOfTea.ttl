    bf:originDate "1922" ;
    dcterms:source <https://www.loc.gov/item/22019708/> ;
    dcterms:rights "Free eBook from the Library of Congress" ;
    dcterms:abstract "This collection of narratives and guides explores the founding and management of early 20th-century tea rooms, offering both practical business advice and personal success stories." ;
