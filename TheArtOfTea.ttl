        <https://www.wikidata.org/wiki/Q9333>,
        <http://viaf.org/viaf/77109647>,
        <http://viaf.org/viaf/77154987>,
        <http://id.loc.gov/authorities/subjects/sh2020004829> ;
    dcterms:hasVersion ArTea:BookOfTeaXML ;
    crm:P129_is_about ArTea:Tea .

ArTea:arTea08 a schema:Book ;
    bf:mainTitle "Tea room booklet" ;
    dcterms:contributor "N/A" ;
    bf:responsibilityStatement "New York, Woman's home companion" ;
    bf:place <https://www.loc.gov/item/22019708/> ;
