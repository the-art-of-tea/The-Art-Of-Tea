    bf:originPlace "New York" ;
    bf:originDate "1906" ;
    dcterms:source "!" ; # to be found
    dcterms:rights "Free eBook from the Internet Archive" ;
    dcterms:format "310.5M" ;
    dcterms:abstract "!" ; # to be written
    dcterms:subject "-" ; # URIs of the Subject Headings
    dcterms:hasVersion ArTea:BookOfTeaXML; # our XML
    crm:P129_is_about ArTea:Tea . # ! so the Work is linked to the Tea

