# ! Defining Tea
ArTea:Tea a crm:E22_Human_Made_Object ;
    rdfs:label "Tea";
    crm:P129_is_subject_of ArTea:BookOfTea, 
    ArTea:Chanoyu,
    ArTea:WomanPerforming . # etc.

# ArTea XML Entities

ArTea:BookOfTeaXML a schema:DigitalDocument ;
    bf:responsibilityStatement "XML created by The Art of Team Team" ;
    bf:mainTitle "The Book of Tea XML" ;
    bf:originDate "2026" ;
    bf:originPlace "University of Bologna (BO)" ;
    dcterms:source "https://github.com/the-art-of-tea/The-Art-Of-Tea/tree/main" ;
    dcterms:rights <https://creativecommons.org/publicdomain/mark/1.0/> .

# Books 

ArTea:BookOfTea a schema:Book;
    bf:identifiedby <https://archive.org/search.php?query=external-identifier%3A%22urn%3Aoclc%3Arecord%3A1041561203%22> ; # to be written
    bf:mainTitle "The Book of Tea" ;
    dcterms:contributor <http://viaf.org/viaf/99830297> ;
    bf:responsibilityStatement "University of California Libraries" ;
    bf:agent "London, New York, Putman's sons" ;
    bf:date "2007-11-01T16:43:02Z"^^xsd:dateTime ;
