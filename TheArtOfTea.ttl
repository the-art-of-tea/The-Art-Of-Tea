# Books 

ArTea:arTea05 a schema:Book ;
    bf:identifiedBy "littleteabook00grayrich" ;
    bf:mainTitle "The Little Tea Book" ;
    dcterms:contributor "http://viaf.org/viaf/44670260" ;
    bf:responsibilityStatement "University of California Libraries" ;
    bf:agent "New York : Baker & Taylor" ;
    bf:date "2007-01-25 00:30:45"^^xsd:dateTime ;
    bf:place <https://archive.org/details/littleteabook00grayrich/> ;
    bf:originPlace "New York" ;
    bf:originDate "1903" ;
    dcterms:source <https://archive.org/details/littleteabook00grayrich/> ;
    dcterms:rights "Free eBook from the Internet Archive" ;
    dcterms:format "310.5M" ;
    dcterms:abstract "The little book of tea is a collection of short tales and poems about tea, exploring its history, traditions, and tea drinking customs across different cultures." ;
    dcterms:subject 
        <http://id.loc.gov/authorities/subjects/sh85132924>,
        <https://lccn.loc.gov/sh85132933>,
        <https://lccn.loc.gov/sh2010115714>,
        <http://viaf.org/viaf/29565694>,
        <https://lccn.loc.gov/sh85132940> ;
    dcterms:hasVersion ArTea:LittleTeaBookXML ;
    crm:P129_is_about ArTea:Tea .

ArTea:arTea06 a schema:Book ;
    bf:identifiedBy "journeytoteacoun00fort" ;
    bf:mainTitle "Journey to the Tea Countries of China" ;
    dcterms:contributor <http://viaf.org/viaf/4988075> ;
    bf:responsibilityStatement "Harold B. Lee Library" ;
    bf:agent "John Murray" ;
    bf:date "2011-12-15T03:31:02"^^xsd:dateTime ;
    bf:place <https://archive.org/details/journeytoteacoun00fort/> ;
    bf:originPlace "London" ;
    bf:originDate "1852" ;
    dcterms:source <https://archive.org/details/journeytoteacoun00fort/> ;
    dcterms:rights "Free eBook from the Internet Archive" ;
    dcterms:format "781.0M" ;
    dcterms:abstract "Including Sung-Lo and the Bohea hills; with a short notice of the East India Company's tea plantations in the Himalaya mountains - This book acts as the travelogue of the Scottish botanist Robert Fortune, probably the first western foreigner to travel to China in order to learn about the cultivation of tea, which up until that point had remained a mystery to the West. These secrets were of great interest to the East India Company who tasked Fortune with stealing a sample of tea leaves in order to start their own plantations in India." ;
    dcterms:subject 
        <https://lccn.loc.gov/sh85019114>,
        <https://lccn.loc.gov/sh2009000722>,
        <https://lccn.loc.gov/sh2009002994>,
        <https://lccn.loc.gov/sh85149720>,
        <https://lccn.loc.gov/sh85095095>,
        <https://lccn.loc.gov/sh8513294>,
        <https://lccn.loc.gov/sh2008112604> ;
    crm:P129_is_about ArTea:Tea .

ArTea:arTea07 a schema:Book ;
    bf:identifiedBy "bookoftea00okakrich" ;
    bf:mainTitle "The Book of Tea" ;
    dcterms:contributor <http://viaf.org/viaf/99830297> ;
    bf:responsibilityStatement "University of California Libraries" ;
    bf:agent "London, New York, Putman's sons" ;
    bf:date "2007-11-01T16:43:02Z"^^xsd:dateTime ;
    bf:place <https://archive.org/details/bookoftea00okakrich/mode/2up> ;
    bf:originPlace "New York" ;
    bf:originDate "1906" ;
    dcterms:source <https://archive.org/details/bookoftea00okakrich/page/44/mode/2up> ;
    dcterms:rights "Free eBook from the Internet Archive" ;
    dcterms:format "310.5M" ;
    dcterms:abstract "The Book of Tea describes all aspects of the Japanese tea ceremony and explains how its rituals blend seamlessly with traditional Japanese life." ;
    dcterms:subject 
        <http://id.loc.gov/authorities/subjects/sh85132924>,
        <http://id.loc.gov/authorities/subjects/sh85069725>,
